// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Enums
enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

model User {
  id                     String       @id @default(uuid())
  name                   String
  email                  String       @unique
  password               String? //Optional for OAuth
  mobileNumber           String?
  provider               AuthProvider @default(CREDENTIALS)
  emailVerified          DateTime?
  verificationCode       String?
  verificationCodeExpiry DateTime?
  state                  String? //Optional for initial OAuth
  district               String? //Optional for initial OAuth
  cropPreferences        String[]     @default([])

  isOnboarding Boolean @default(false) //Custom flag for onboarding check for OAuth

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //For  NextAuth's Prisma adapter
  accounts Account[]
  sessions Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Commodity {
  id String @id @default(uuid())
  name String  @unique

  prices MarketPrice[]
}

model Market {
  id String @id @default(uuid())
  name String
  state String
  district String
  
  prices MarketPrice[]

  @@unique([name, state, district])
}

model MarketPrice {
  id String @id @default(uuid())
  commodityId String
  marketId String
  date DateTime
  variety String?
  minPrice Float
  maxPrice Float
  modalPrice Float

  commodity Commodity @relation(fields: [commodityId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  @@unique([commodityId, marketId, date, variety])
}

//For tracking daily ingestions
model IngestionJob {
  id String @id @default(uuid())
  status IngestionStatus
  startedAt DateTime @default(now())
  completedAt DateTime?
  recordsProcessed Int @default(0)
  recordsFailed Int @default(0)
  errorMessage String?
}